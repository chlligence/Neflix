# 视频清单接口（必须支持 page / pageSize 查询参数，返回分页结果）
# 留空时默认启用内置演示数据。
VITE_VIDEO_MANIFEST_URL=

# 可选：清单接口基础地址。VITE_VIDEO_MANIFEST_URL 可写成相对路径 /api/videos。
VITE_MANIFEST_API_BASE_URL=

# CDN 播放域名。清单中的相对播放地址会基于此地址补全。
# 生产环境示例：https://cdn.example.com
VITE_CDN_BASE_URL=

# 可选：封面图域名。未设置时沿用 CDN 域名。
VITE_IMAGE_BASE_URL=

# true 使用应用内置演示片源；接入真实接口前请改为 false。
VITE_DEMO_MODE=true

# 支持 auto / hls / dash。auto 会按清单中播放源的顺序选择。
VITE_PREFERRED_FORMAT=auto

# 分页与超时配置
VITE_PAGE_SIZE=4
VITE_REQUEST_TIMEOUT_MS=12000
VITE_LOADING_TIMEOUT_MS=30000
VITE_BUFFER_TIMEOUT_MS=20000
VITE_PROGRESS_SAVE_INTERVAL_MS=5000

# 以下为对象存储接入信息，仅供本地配置与联调识别，不参与客户端播放。
# 不要在此文件或任何 VITE_* 变量中放置 AccessKeySecret，这些变量会被打包进客户端。
VITE_OSS_BUCKET=
VITE_OSS_REGION=
VITE_OSS_ENDPOINT=